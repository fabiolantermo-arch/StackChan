{
  "name": "robottino-stackchan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf:types": "wrangler types",
    "test": "vitest run && npm run test:firmware",
    "test:firmware": "node --experimental-vm-modules --test firmware/stackchan-mod/*.test.mjs firmware/host/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "test:watch": "vitest",
    "robot:virtual": "node scripts/virtual-robot.mjs",
    "robot:talk": "node --experimental-vm-modules --no-warnings scripts/robot-talk.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wrangler": "^4.158.0",
    "ws": "8.21.0"
  }
}
