+# Robottino (firmware/host/build-host.mjs): sources of the host that cannot be XS modules (C++ that uses ESP-IDF
+# components), compiled with the project. Each such file defines robottino_main_sources, named here so that the
+# linker keeps it.
+if (DEFINED ENV{ROBOTTINO_MAIN_SOURCES})
+	target_sources(${COMPONENT_TARGET} PRIVATE $ENV{ROBOTTINO_MAIN_SOURCES})
+	target_link_libraries(${COMPONENT_LIB} INTERFACE "-u robottino_main_sources")
+endif()
