@@ -97,3 +97,108 @@ test('SingleWaitSlot reports overlapping waits without queuing them', () => {
     false,
   )
 })
+
+// Robottino (10 Nov 2026): a reply that arrived in time but was read late is not a timeout.
+test('SingleWaitSlot lets beforeTimeout deliver a reply that was already there', () => {
+  let scheduled: (() => void) | null = null
+  let timedOut = false
+  let result: number[] | undefined
+  let cleared = 0
+  const slot: SingleWaitSlot<number[]> = new SingleWaitSlot<number[]>(
+    (handler) => {
+      scheduled = handler
+      return Symbol('timer')
+    },
+    () => {
+      cleared++
+    },
+  )
+  slot.wait(
+    10,
+    (value) => {
+      result = value
+    },
+    () => {
+      timedOut = true
+    },
+    () => slot.resolve([7]),
+  )
+  scheduled?.()
+  assert.deepEqual(result, [7])
+  assert.equal(timedOut, false)
+  assert.equal(slot.isWaiting, false)
+  assert.equal(cleared, 0, 'the timer has already fired: nothing to clear')
+})
+
+test('SingleWaitSlot still times out when beforeTimeout finds nothing', () => {
+  let scheduled: (() => void) | null = null
+  let timedOut = false
+  let called = false
+  let looked = 0
+  const slot = new SingleWaitSlot<number[]>(
+    (handler) => {
+      scheduled = handler
+      return Symbol('timer')
+    },
+    () => {},
+  )
+  slot.wait(
+    10,
+    () => {
+      called = true
+    },
+    () => {
+      timedOut = true
+    },
+    () => {
+      looked++
+    },
+  )
+  scheduled?.()
+  assert.equal(looked, 1)
+  assert.equal(called, false)
+  assert.equal(timedOut, true)
+  assert.equal(slot.isWaiting, false)
+  // A reply after the timeout is ignored, as before.
+  slot.resolve([1])
+  assert.equal(called, false)
+})
+
+test('SingleWaitSlot leaves alone a wait started by the late reply', () => {
+  const timers: (() => void)[] = []
+  let firstTimedOut = false
+  let secondTimedOut = false
+  let second: number[] | undefined
+  const slot: SingleWaitSlot<number[]> = new SingleWaitSlot<number[]>(
+    (handler) => {
+      timers.push(handler)
+      return Symbol('timer')
+    },
+    () => {},
+  )
+  slot.wait(
+    10,
+    () => {
+      // the next command of the chain starts from the reply's callback
+      slot.wait(
+        10,
+        (value) => {
+          second = value
+        },
+        () => {
+          secondTimedOut = true
+        },
+      )
+    },
+    () => {
+      firstTimedOut = true
+    },
+    () => slot.resolve([1]),
+  )
+  timers[0]()
+  assert.equal(firstTimedOut, false)
+  assert.equal(slot.isWaiting, true, 'the second wait is still pending')
+  slot.resolve([2])
+  assert.deepEqual(second, [2])
+  assert.equal(secondTimedOut, false)
+})
