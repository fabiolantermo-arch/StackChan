{
  "include": [
    "$(MODDABLE)/examples/manifest_mod.json"
  ],
  "config": {
    "driver": {
      "config": {
        "yaw": {"angleLimit": {"min": -1440, "max": 1690}},
        "pitch": {"angleLimit": {"min": -1940, "max": 1190}}
      }
    }
  },
  "modules": {
    "*": "./mod",
